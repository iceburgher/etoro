# Nycklar hör hemma här (aldrig i git). Kopiera till .env
ETORO_USER_KEY=
ETORO_API_KEY=
# DRY_RUN (standard) = inga ordrar. REAL_MICRO = autonom handel med riktiga pengar.
EXECUTION_MODE=DRY_RUN
# Måste matcha kontot nycklarna hör till, annars startar inte REAL_MICRO
EXPECTED_PORTFOLIO=AI Burger-UMYYUR
# Avsatt kapital i SEK = riskbasen (0,25 % per affär)
ALLOCATED_CAPITAL_SEK=9983.59
# Nödbrytare: 1 = inga nya öppningar (stängningar tillåts). Alternativt skapa filen KILL_SWITCH.
KILL_SWITCH=0
STATE_FILE=state.json
